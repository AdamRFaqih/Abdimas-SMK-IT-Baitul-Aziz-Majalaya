# ==============================================================================
# Environment Configuration for Docker Deployment
# ==============================================================================
APP_NAME="SMK IT Baitul Aziz"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ==============================================================================
# Database Configuration (Docker MySQL Service)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=abdimas
DB_USERNAME=abdimas_user
DB_PASSWORD=abdimas_secret
DB_ROOT_PASSWORD=root_secret

# Host Port Mappings
APP_PORT=8000
DB_EXTERNAL_PORT=3306

# Cloudflare Tunnel Token (optional, if using cloudflared container)
# CLOUDFLARE_TUNNEL_TOKEN=

# Auto-migration on container startup (true/false)
AUTO_MIGRATE=true

# ==============================================================================
# Sessions, Cache, and Queue
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

# ==============================================================================
# Mail Settings (Update with your SMTP credentials in production)
# ==============================================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@smkitbaitulaziz.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
